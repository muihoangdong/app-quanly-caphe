<?xml version="1.0" encoding="utf-8"?>
<!-- Trang chủ: lời chào, tạo đơn hàng, thao tác nhanh, bàn đang phục vụ, hoạt động gần đây -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienTrangChuActivity">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Báo lỗi kết nối máy chủ -->
            <LinearLayout
                android:id="@+id/layoutLoiKetNoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill_red"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/txtLoiKetNoi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/status_red"
                    android:textSize="13sp"
                    tools:text="Không kết nối được máy chủ" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMayChu"
                        style="@style/NutNguyHiem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="Địa chỉ máy chủ" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThuLai"
                        style="@style/NutNguyHiem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="Thử lại" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lời chào nhân viên -->
            <LinearLayout
                android:id="@+id/layoutNhanVien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="Ảnh đại diện"
                    android:padding="10dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/forest_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xin chào,"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtTenNhanVien"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhân viên"
                        android:textColor="@color/forest_green"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Nguyễn Văn A" />

                    <TextView
                        android:id="@+id/txtVaiTro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        tools:text="Nhân viên" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnDangXuat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_latte"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Đăng xuất"
                    android:textColor="@color/forest_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_logout"
                    app:drawableTint="@color/forest_green" />
            </LinearLayout>

            <!-- Banner chào mừng -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTaoDonHang"
                style="@style/NutChinh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tạo đơn hàng"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart" />

            <!-- Thao tác nhanh -->
            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Thao tác nhanh" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/btnSoDoBanNhanh"
                    layout="@layout/item_thao_tac_nhanh" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/btnGoiMonNhanh"
                    layout="@layout/item_thao_tac_nhanh" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/btnDonHangNhanh"
                    layout="@layout/item_thao_tac_nhanh" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/btnHoaDonNhanh"
                    layout="@layout/item_thao_tac_nhanh" />
            </LinearLayout>

            <!-- Bàn đang phục vụ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TieuDeMuc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bàn đang phục vụ" />

                <TextView
                    android:id="@+id/txtXemTatCaBan"
                    style="@style/LienKet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutBanDangPhucVu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_the_trang"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Hoạt động gần đây: hóa đơn vừa thanh toán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TieuDeMuc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hoạt động gần đây" />

                <TextView
                    android:id="@+id/txtXemTatCaHoaDon"
                    style="@style/LienKet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHoatDong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_the_trang"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
