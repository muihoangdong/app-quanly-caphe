<?xml version="1.0" encoding="utf-8"?>
<!-- Tài khoản nhân viên (chỉ quản lý): danh sách tài khoản, chạm để đặt lại mật khẩu / khóa -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienTaiKhoanActivity">

    <include layout="@layout/layout_thanh_tieu_de" />

    <ListView
        android:id="@+id/lvTaiKhoan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none" />
</LinearLayout>
