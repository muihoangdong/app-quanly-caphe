<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ chức năng ở trang Quản lý / Cài đặt: icon, tiêu đề, mô tả, mũi tên -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_the_trang"
    android:stateListAnimator="@animator/nhan_nut"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/imgTheQuanLy"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_icon_mint"
        android:contentDescription="Biểu tượng"
        android:padding="12dp"
        app:tint="@color/forest_green"
        tools:src="@drawable/ic_cup" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTenTheQuanLy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Thực đơn" />

        <TextView
            android:id="@+id/txtMoTaTheQuanLy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            tools:text="Quản lý món, danh mục" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Mở"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_hint" />
</LinearLayout>
