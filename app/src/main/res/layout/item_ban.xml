<?xml version="1.0" encoding="utf-8"?>
<!-- Ô bàn trên sơ đồ: icon bàn ghế, chấm trạng thái, tên, trạng thái, tạm tính -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutBan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ban_trong"
    android:stateListAnimator="@animator/nhan_nut"
    android:minHeight="112dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgBan"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Bàn"
            android:src="@drawable/ic_table"
            app:tint="@color/forest_green" />

        <TextView
            android:id="@+id/txtTenBan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Bàn 1" />

        <TextView
            android:id="@+id/txtTrangThaiBan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Trống" />

        <TextView
            android:id="@+id/txtTamTinhBan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cam"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="120.000đ"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtKhuVucBan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        tools:text="Tầng 1" />

    <View
        android:id="@+id/viewChamBan"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/bg_cham_xanh" />
</FrameLayout>
