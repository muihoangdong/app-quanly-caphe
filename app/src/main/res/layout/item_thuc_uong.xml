<?xml version="1.0" encoding="utf-8"?>
<!-- Một món trong danh sách Gọi món / Thực đơn: ảnh, tên, giá, nút - (khi đã có trong giỏ) và + -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp">

        <ImageView
            android:id="@+id/imgThucUong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_icon_mint"
            android:contentDescription="Ảnh món"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_mon_ca_phe_sua" />

        <TextView
            android:id="@+id/txtHetMon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_dark"
            android:backgroundTint="#99173D2B"
            android:gravity="center"
            android:text="Hết"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTenThucUong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Cà phê sữa" />

            <TextView
                android:id="@+id/txtBanChay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="Bán chạy"
                android:textColor="@color/status_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMoTaThucUong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            tools:text="Phin sữa đặc truyền thống" />

        <TextView
            android:id="@+id/txtGiaThucUong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/forest_green"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="40.000đ" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnBotKhoiGio"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_circle_latte"
        android:contentDescription="Bớt khỏi giỏ"
        android:focusable="false"
        android:padding="7dp"
        android:src="@drawable/ic_remove"
        android:visibility="gone"
        app:tint="@color/forest_green"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/btnThemVaoGio"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_nut_cong"
            android:contentDescription="Thêm vào giỏ"
            android:focusable="false"
            android:padding="7dp"
            android:src="@drawable/ic_add"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtSoLuongTrongGio"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_circle_dark"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="2"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
