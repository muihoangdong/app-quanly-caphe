<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Quản lý món & Thêm món mới (thiết kế: qu_n_l_m_n_th_m_m_n_m_i) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienThemMonActivity">

    <include layout="@layout/layout_thanh_tieu_de" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Ảnh đại diện món -->
            <LinearLayout
                style="@style/TheCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTieuDe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_image"
                    android:drawablePadding="8dp"
                    android:text="Ảnh đại diện món" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgAnhMon"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_soft"
                        android:contentDescription="Ảnh món"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_coffee" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChonAnh"
                            style="@style/NutToi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đổi ảnh từ thư viện"
                            android:textSize="13sp"
                            app:backgroundTint="@color/mocha"
                            app:icon="@drawable/ic_image"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnXoaAnh"
                            style="@style/NutPhu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dùng ảnh mặc định"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_close"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Thông tin cơ bản -->
            <LinearLayout
                style="@style/TheCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTieuDe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_coffee"
                    android:drawablePadding="8dp"
                    android:text="Thông tin món cơ bản" />

                <TextView
                    style="@style/TextNhapLieu"
                    android:text="Tên món hiển thị trên Bill &amp; Menu *" />

                <EditText
                    android:id="@+id/edtTenMon"
                    style="@style/ONhapLieu"
                    android:hint="VD: Cà phê Muối Cốt Dừa"
                    android:inputType="textCapSentences" />

                <TextView
                    style="@style/TextNhapLieu"
                    android:text="Mã SKU / Barcode" />

                <EditText
                    android:id="@+id/edtMaMon"
                    style="@style/ONhapLieu"
                    android:fontFamily="monospace"
                    android:hint="CF-MUOI-01"
                    android:inputType="textCapCharacters" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextNhapLieu"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Danh mục đồ uống" />

                    <TextView
                        android:id="@+id/txtTaoNhomMoi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:padding="4dp"
                        android:text="+ Tạo nhóm mới"
                        android:textColor="@color/caramel_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spDanhMuc"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="6dp" />

                <TextView
                    style="@style/TextNhapLieu"
                    android:text="Mô tả hương vị (in bill &amp; app khách)" />

                <EditText
                    android:id="@+id/edtMoTa"
                    style="@style/ONhapLieu"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Cà phê Robusta Đắk Lắk kết hợp lớp kem muối..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>

            <!-- Định giá & lợi nhuận -->
            <LinearLayout
                style="@style/TheCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTieuDe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_cash"
                    android:drawablePadding="8dp"
                    android:text="Định giá &amp; Tối ưu lợi nhuận" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextNhapLieu"
                            android:text="Giá bán niêm yết (VNĐ) *" />

                        <EditText
                            android:id="@+id/edtGiaBan"
                            style="@style/ONhapLieu"
                            android:hint="45000"
                            android:inputType="number"
                            android:maxLength="9"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextNhapLieu"
                            android:text="Giá vốn nguyên liệu" />

                        <EditText
                            android:id="@+id/edtGiaVon"
                            style="@style/ONhapLieu"
                            android:background="@drawable/bg_card_latte"
                            android:hint="14500"
                            android:inputType="number"
                            android:maxLength="9" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_latte"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_amber"
                        android:contentDescription="Lợi nhuận"
                        android:padding="9dp"
                        android:src="@drawable/ic_trending"
                        app:tint="@color/caramel_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtLoiNhuanGop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lợi nhuận gộp: --"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtBienLoiNhuan"
                            style="@style/TextNhan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhập giá bán và giá vốn"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDanhGiaLoiNhuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_caramel"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Lãi tốt"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Vận hành -->
            <LinearLayout
                style="@style/TheCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTieuDe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_table"
                    android:drawablePadding="8dp"
                    android:text="Vận hành &amp; Kiểm soát" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swConBan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:minHeight="56dp"
                    android:text="Đang phục vụ / Cho phép gọi món"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/caramel" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swBanChay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Món đặc trưng (Best-seller)"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Thanh nút dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXoaMon"
            style="@style/NutNguyHiem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="Xóa món"
            app:icon="@drawable/ic_delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLuuMon"
            style="@style/NutChinh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Lưu &amp; Mở bán"
            app:backgroundTint="@color/espresso"
            app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>
