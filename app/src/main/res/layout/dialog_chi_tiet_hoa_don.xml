<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại xem chi tiết hóa đơn đã thanh toán / đã hủy -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/txtThongTinChiTiet"
            style="@style/TextNhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            tools:text="#HD-20261020-0004\nVào 14:15 • Ra 15:20 • 4 khách" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="@color/outline_soft" />

        <LinearLayout
            android:id="@+id/layoutMonChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/outline_soft" />

        <TextView
            android:id="@+id/txtTongKetChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            tools:text="Tạm tính: 214.000đ\nGiảm giá: -30.000đ" />

        <TextView
            android:id="@+id/txtTongCongChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:textColor="@color/caramel"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="199.000đ" />
    </LinearLayout>
</ScrollView>
