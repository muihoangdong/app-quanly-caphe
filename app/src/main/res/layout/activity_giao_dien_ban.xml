<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Sơ đồ bàn (thiết kế: s_b_n_qu_n_l_khu_v_c) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienBanActivity">

    <include layout="@layout/layout_header" />

    <!-- Hàng thao tác nhanh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoiBan"
            style="@style/NutPhu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Đổi bàn"
            android:textSize="13sp"
            app:icon="@drawable/ic_swap"
            app:iconSize="18dp"
            app:iconTint="@color/caramel_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGopBan"
            style="@style/NutPhu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Gộp bàn"
            android:textSize="13sp"
            app:icon="@drawable/ic_merge"
            app:iconSize="18dp"
            app:iconTint="@color/caramel_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemBan"
            style="@style/NutPhu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Thêm bàn"
            android:textColor="@color/caramel_dark"
            android:textSize="13sp"
            app:backgroundTint="@color/caramel_soft"
            app:icon="@drawable/ic_add"
            app:iconSize="18dp"
            app:iconTint="@color/caramel_dark" />
    </LinearLayout>

    <!-- Thống kê nhanh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_latte"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtSoCoKhach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/status_amber"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Có khách"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_latte"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtSoBanTrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bàn trống"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_latte"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtSoChoThanhToan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/caramel_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ thanh toán"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lọc theo khu vực -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/rgKhuVuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gvBan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="12dp"
            android:numColumns="2"
            android:padding="16dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />

        <TextView
            android:id="@+id/txtKhongCoBan"
            style="@style/TextNhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Quán chưa có bàn nào.
Bấm &quot;Thêm bàn&quot; để tạo bàn đầu tiên."
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
