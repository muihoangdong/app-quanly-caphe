<?xml version="1.0" encoding="utf-8"?>
<!-- Quản lý bàn: lọc theo trạng thái, lưới bàn 2 cột -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienBanActivity">

    <include layout="@layout/layout_thanh_tieu_de" />

    <EditText
        android:id="@+id/edtTimBan"
        style="@style/ONhapLieu"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_o_tim_kiem"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/text_hint"
        android:hint="Tìm bàn..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Lọc theo trạng thái -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/rgTrangThaiBan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkedButton="@id/radTatCaBan"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radTatCaBan"
                style="@style/ChipLoc"
                android:text="Tất cả" />

            <RadioButton
                android:id="@+id/radBanTrong"
                style="@style/ChipLoc"
                android:text="Trống" />

            <RadioButton
                android:id="@+id/radBanPhucVu"
                style="@style/ChipLoc"
                android:text="Đang phục vụ" />

            <RadioButton
                android:id="@+id/radBanCanXuLy"
                style="@style/ChipLoc"
                android:text="Bàn đặt trước" />
        </RadioGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gvBan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="12dp"
            android:numColumns="2"
            android:padding="16dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />

        <TextView
            android:id="@+id/txtKhongCoBan"
            style="@style/TextNhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Không có bàn nào"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
