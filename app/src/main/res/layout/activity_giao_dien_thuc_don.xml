<?xml version="1.0" encoding="utf-8"?>
<!-- Gọi món (mục Thực đơn) và Quản lý thực đơn: tìm món, lọc danh mục, danh sách món, giỏ hàng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienThucDonActivity">

    <include layout="@layout/layout_thanh_tieu_de" />

    <!-- Tìm kiếm -->
    <EditText
        android:id="@+id/edtTimKiem"
        style="@style/ONhapLieu"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_o_tim_kiem"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/text_hint"
        android:hint="Tìm món..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <!-- Danh mục -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/rgDanhMuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txtTongSoMon"
        style="@style/TextNhan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="15 món"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvThucUong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/outline_soft"
            android:dividerHeight="1dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/txtKhongCoMon"
            style="@style/TextNhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Không tìm thấy món phù hợp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Giỏ hàng -->
    <LinearLayout
        android:id="@+id/layoutGioHang"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_cart_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Giỏ hàng"
            android:src="@drawable/ic_cart"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSoLuongGio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mint_light"
                android:textSize="12sp"
                tools:text="3 món" />

            <TextView
                android:id="@+id/txtTongGio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="135.000đ" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXemGio"
            style="@style/NutPhu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Xem giỏ hàng"
            android:textSize="14sp"
            app:backgroundTint="@color/mint_light"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
