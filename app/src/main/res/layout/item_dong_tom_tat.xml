<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng tóm tắt ở trang chủ: bàn đang phục vụ / hoạt động gần đây -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/imgDong"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_mint"
        android:contentDescription="Biểu tượng"
        android:padding="9dp"
        android:src="@drawable/ic_table"
        app:tint="@color/forest_green" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTieuDeDong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Bàn 3" />

        <TextView
            android:id="@+id/txtPhuDong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="2 món - 85.000đ" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPhaiDong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        tools:text="10:24" />
</LinearLayout>
