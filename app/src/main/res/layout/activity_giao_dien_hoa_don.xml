<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình danh sách đơn hàng / hóa đơn -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienHoaDonActivity">

    <include layout="@layout/layout_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/TextTieuDe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hóa đơn"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/txtTongKetHoaDon"
            style="@style/TextNhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="7 đơn • 1.250.000đ" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/rgTrangThaiHoaDon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radTatCaHD"
                style="@style/ChipLoc"
                android:checked="true"
                android:text="Tất cả" />

            <RadioButton
                android:id="@+id/radDangPhucVu"
                style="@style/ChipLoc"
                android:text="Đang phục vụ" />

            <RadioButton
                android:id="@+id/radDaThanhToan"
                style="@style/ChipLoc"
                android:text="Đã thanh toán" />

            <RadioButton
                android:id="@+id/radDaHuy"
                style="@style/ChipLoc"
                android:text="Đã hủy" />
        </RadioGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvHoaDon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:padding="16dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/txtKhongCoHoaDon"
            style="@style/TextNhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Chưa có hóa đơn nào"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
