<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình đăng nhập chung: tab Khách hàng / Nhân viên - Quản trị -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dang_nhap"
    android:fillViewport="true"
    tools:context=".DangNhapActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_card_dark">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="Logo"
                android:src="@drawable/ic_coffee"
                app:tint="@color/caramel" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/espresso_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLoiChao"
            style="@style/TextNhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Đặt bàn, gọi món và thanh toán ngay trên điện thoại" />

        <!-- Chọn loại tài khoản -->
        <RadioGroup
            android:id="@+id/rgLoaiTaiKhoan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_pill_latte"
            android:orientation="horizontal"
            android:padding="4dp">

            <RadioButton
                android:id="@+id/radKhachHang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_dang_nhap"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="Khách hàng"
                android:textColor="@color/tab_dang_nhap_chu"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radNhanVien"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_dang_nhap"
                android:button="@null"
                android:gravity="center"
                android:text="Nhân viên / Admin"
                android:textColor="@color/tab_dang_nhap_chu"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtNhanTaiKhoan"
                style="@style/TextNhapLieu"
                android:layout_marginTop="0dp"
                android:text="Số điện thoại" />

            <EditText
                android:id="@+id/edtTaiKhoan"
                style="@style/ONhapLieu"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="10dp"
                android:hint="VD: 0909123456"
                android:importantForAutofill="no"
                android:inputType="phone" />

            <TextView
                style="@style/TextNhapLieu"
                android:text="Mật khẩu" />

            <EditText
                android:id="@+id/edtMatKhau"
                style="@style/ONhapLieu"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="10dp"
                android:hint="Nhập mật khẩu"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/chkHienMatKhau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hiện mật khẩu"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDangNhap"
                style="@style/KNutChinh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Đăng nhập" />

            <TextView
                android:id="@+id/txtDangKy"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Chưa có tài khoản? Đăng ký ngay"
                android:textColor="@color/tch_cam"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Gợi ý tài khoản dùng thử -->
        <TextView
            android:id="@+id/txtGoiYTaiKhoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_latte"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Tài khoản dùng thử: 0909123456 / 123456" />
    </LinearLayout>
</ScrollView>
