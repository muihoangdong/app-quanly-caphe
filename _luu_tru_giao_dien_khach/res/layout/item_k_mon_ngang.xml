<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ món nổi bật cuộn ngang ở trang chủ khách -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_k_the"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgMonNgang"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@drawable/bg_icon_soft"
        android:contentDescription="Ảnh món"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_coffee" />

    <TextView
        android:id="@+id/txtTenMonNgang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lines="2"
        android:textColor="@color/tch_chu"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Cà phê Muối Đặc Biệt" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtGiaMonNgang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tch_chu"
            android:textSize="13sp"
            tools:text="39.000đ" />

        <ImageView
            android:id="@+id/btnThemMonNgang"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_k_tron_cam"
            android:contentDescription="Thêm vào giỏ"
            android:padding="5dp"
            android:src="@drawable/ic_add"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
