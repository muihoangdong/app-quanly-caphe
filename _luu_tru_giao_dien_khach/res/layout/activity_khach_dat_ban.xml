<?xml version="1.0" encoding="utf-8"?>
<!-- Khách: xem bàn còn trống theo ngày giờ và đặt bàn -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tch_nen"
    android:orientation="vertical"
    tools:context=".KhachDatBanActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/KTieuDeMuc"
            android:text="Đặt bàn" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn ngày giờ, xem bàn còn trống và giữ chỗ trước"
            android:textColor="@color/tch_chu_phu"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Thời gian & số người -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/KNhan"
                    android:layout_marginStart="16dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/tch_cam"
                    android:gravity="center_vertical"
                    android:text="Ngày" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scrollbars="none">

                    <RadioGroup
                        android:id="@+id/rgNgayDat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    style="@style/KNhan"
                    android:layout_marginStart="16dp"
                    android:drawableStart="@drawable/ic_time"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/tch_cam"
                    android:gravity="center_vertical"
                    android:text="Giờ đến" />

                <HorizontalScrollView
                    android:id="@+id/hsvGioDat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scrollbars="none">

                    <RadioGroup
                        android:id="@+id/rgGioDat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/txtHetGioHomNay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Hôm nay đã hết khung giờ đặt, vui lòng chọn ngày khác"
                    android:textColor="@color/status_red"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_people"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/tch_cam"
                        android:gravity="center_vertical"
                        android:text="Số người"
                        android:textColor="@color/tch_chu"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnGiamNguoi"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_k_tron_nhat"
                        android:contentDescription="Giảm"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/tch_cam" />

                    <TextView
                        android:id="@+id/txtSoNguoi"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/tch_chu"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTangNguoi"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_k_tron_cam"
                        android:contentDescription="Tăng"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    style="@style/KNhan"
                    android:layout_marginStart="16dp"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/tch_cam"
                    android:gravity="center_vertical"
                    android:text="Khu vực" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scrollbars="none">

                    <RadioGroup
                        android:id="@+id/rgKhuVucDat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Danh sách bàn trống -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KTieuDeMuc"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Bàn còn trống"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtSoBanTrongDat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_k_pill_nhat"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/tch_cam_dam"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="5 bàn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMoTaKhungGio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tch_chu_phu"
                    android:textSize="12sp"
                    tools:text="Thứ Tư 21/10 • 19:00 • 4 người" />

                <LinearLayout
                    android:id="@+id/layoutDsBanTrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtKhongCoBanTrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_k_o_nhap"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Không còn bàn phù hợp.\nHãy thử giờ khác, khu vực khác hoặc giảm số người."
                    android:textColor="@color/tch_chu_phu"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/KNhan"
                    android:text="Ghi chú cho quán" />

                <EditText
                    android:id="@+id/edtGhiChuDat"
                    style="@style/KONhap"
                    android:hint="Sinh nhật, cần ghế em bé, gần cửa sổ..."
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Thanh xác nhận -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/txtBanDaChon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chưa chọn bàn"
            android:textColor="@color/tch_chu"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXacNhanDat"
            style="@style/KNutChinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="Đặt bàn"
            android:textSize="15sp" />
    </LinearLayout>

    <include layout="@layout/layout_k_bottom_nav" />
</LinearLayout>
