<?xml version="1.0" encoding="utf-8"?>
<!-- Vé đặt bàn: khách đưa màn hình này cho nhân viên khi đến quán -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_k_banner"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_card"
                android:contentDescription="Mã QR"
                android:padding="10dp"
                android:src="@drawable/ic_qr"
                app:tint="@color/tch_chu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="MÃ ĐẶT BÀN"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMaVe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/white"
                android:textIsSelectable="true"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="DB-20261020-0001" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Đưa mã này cho nhân viên khi đến quán\nđể được dẫn tới bàn"
                android:textColor="@color/tch_cam_nhat"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bàn"
                    android:textColor="@color/tch_chu_phu"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtBanVe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tch_chu"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Bàn 06" />

                <TextView
                    android:id="@+id/txtKhuVucVe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tch_chu"
                    android:textSize="13sp"
                    tools:text="Tầng 2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giờ hẹn"
                    android:textColor="@color/tch_chu_phu"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtGioVe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tch_cam"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="19:00" />

                <TextView
                    android:id="@+id/txtNgayVe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tch_chu"
                    android:textSize="13sp"
                    tools:text="21/10/2026" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/tch_vien" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSoKhachVe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_people"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/tch_chu"
                android:textSize="14sp"
                tools:text="4 người" />

            <TextView
                android:id="@+id/txtTrangThaiVe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_k_pill_nhat"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Chờ đến" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtKhachVe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@color/tch_chu"
            android:textSize="14sp"
            tools:text="Nguyễn Minh Anh • 0909123456" />

        <TextView
            android:id="@+id/txtGhiChuVe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tch_chu_phu"
            android:textSize="13sp"
            tools:text="Ghi chú: Sinh nhật bạn" />

        <TextView
            android:id="@+id/txtDonKemVe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_latte"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Món gọi trước: ..." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Bàn được giữ tối đa 30 phút sau giờ hẹn."
            android:textColor="@color/tch_chu_phu"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
