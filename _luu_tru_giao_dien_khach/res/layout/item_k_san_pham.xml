<?xml version="1.0" encoding="utf-8"?>
<!-- Một món trong danh sách Đặt món của khách -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp">

        <ImageView
            android:id="@+id/imgSanPham"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_icon_soft"
            android:contentDescription="Ảnh món"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_coffee" />

        <TextView
            android:id="@+id/txtHetSanPham"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99191919"
            android:gravity="center"
            android:text="Tạm hết"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTenSanPham"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tch_chu"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Cà phê Muối Đặc Biệt" />

        <TextView
            android:id="@+id/txtMoTaSanPham"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tch_chu_phu"
            android:textSize="12sp"
            tools:text="Kem béo bồng bềnh, cà phê Robusta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtGiaSanPham"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tch_chu"
                android:textSize="14sp"
                tools:text="39.000đ" />

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/btnThemSanPham"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/bg_k_tron_cam"
                    android:contentDescription="Thêm vào giỏ"
                    android:focusable="false"
                    android:padding="5dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/txtSoLuongSanPham"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_circle_dark"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="2"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
