<?xml version="1.0" encoding="utf-8"?>
<!-- Một lượt đặt bàn / đơn món trong "Đơn của tôi" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_k_the"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgDongDon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_k_tron_nhat"
            android:contentDescription="Loại"
            android:padding="10dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/tch_cam" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTieuDeDongDon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tch_chu"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Bàn 06 • Tầng 2" />

            <TextView
                android:id="@+id/txtPhuDeDongDon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tch_chu"
                android:textSize="13sp"
                tools:text="19:00 • 21/10/2026 • 4 người" />

            <TextView
                android:id="@+id/txtMaDongDon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/tch_chu_phu"
                android:textSize="11sp"
                tools:text="#DB-20261020-0001" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTrangThaiDongDon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_k_pill_nhat"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Chờ đến" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtChanDongDon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_k_o_nhap"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="@color/tch_chu"
        android:textSize="12sp"
        tools:text="Chạm để xem vé • đưa mã cho nhân viên khi đến" />
</LinearLayout>
