<?xml version="1.0" encoding="utf-8"?>
<!-- Quản trị: danh sách tài khoản nhân viên -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".GiaoDienNhanVienActivity">

    <include layout="@layout/layout_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextTieuDe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhân viên"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtTongNhanVien"
                style="@style/TextNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="4 tài khoản • 3 đang làm" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemNhanVien"
            style="@style/NutChinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Thêm"
            android:textSize="14sp"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <EditText
        android:id="@+id/edtTimNhanVien"
        style="@style/ONhapLieu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:hint="Tìm theo tên, tên đăng nhập, SĐT"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/lvNhanVien"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:padding="16dp"
        android:scrollbars="none" />

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
