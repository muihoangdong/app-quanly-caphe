<?xml version="1.0" encoding="utf-8"?>
<!-- Biểu tượng danh mục tròn ở trang chủ khách -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="76dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/imgDanhMucTron"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_k_tron_nhat"
        android:contentDescription="Danh mục"
        android:padding="14dp"
        android:src="@drawable/ic_coffee"
        app:tint="@color/tch_cam" />

    <TextView
        android:id="@+id/txtDanhMucTron"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/tch_chu"
        android:textSize="12sp"
        tools:text="Cà phê truyền thống" />
</LinearLayout>
